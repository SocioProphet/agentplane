{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReasoningFailureTrace",
  "description": "Typed execution evidence for reasoning failures and multi-agent coordination failures in AgentPlane runs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "trace_id",
    "task_id",
    "actor_id",
    "typed_intent",
    "failure_cluster",
    "failure_annotation",
    "termination_authority",
    "verifier_required",
    "residual_risk",
    "recorded_at"
  ],
  "properties": {
    "apiVersion": { "const": "agentplane.socioprophet.org/v0.1" },
    "kind": { "const": "ReasoningFailureTrace" },
    "trace_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "actor_id": { "type": "string", "minLength": 1 },
    "typed_intent": { "type": "string", "minLength": 1 },
    "failure_cluster": {
      "type": "string",
      "enum": [
        "specification_system_design",
        "inter_agent_misalignment",
        "task_verification_termination"
      ]
    },
    "failure_annotation": { "type": "string", "minLength": 1 },
    "claim_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "invariant_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "evidence_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "assumptions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "uncertainty_notes": { "type": "string" },
    "allowed_tools": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "capability_envelope_ref": { "type": "string", "minLength": 1 },
    "verifier_required": { "type": "boolean" },
    "verifier_decision": {
      "type": "string",
      "enum": ["passed", "failed", "inconclusive", "not_run", "deferred"]
    },
    "termination_authority": { "type": "string", "minLength": 1 },
    "escalation_rule": { "type": "string", "minLength": 1 },
    "residual_risk": {
      "type": "string",
      "enum": ["none", "low", "medium", "high", "critical"]
    },
    "llm_rationale_unsupported": { "type": "boolean" },
    "reasoning_steps": {
  "$id": "https://socioprophet.org/schemas/agentplane/reasoning-failure-trace.v0.1.schema.json",
  "title": "AgentPlane ReasoningFailureTrace v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "version",
    "traceId",
    "sessionRef",
    "taskRef",
    "caseId",
    "receiptRef",
    "failureModeRefs",
    "reasoningTask",
    "agentRun",
    "verifier",
    "invariantChecks",
    "termination",
    "annotations",
    "evidenceRefs",
    "riskAction"
  ],
  "properties": {
    "kind": { "const": "ReasoningFailureTrace" },
    "version": { "const": "0.1" },
    "traceId": { "type": "string", "minLength": 1 },
    "sessionRef": { "type": "string", "minLength": 1 },
    "taskRef": { "type": "string", "minLength": 1 },
    "caseId": { "type": "string", "minLength": 1 },
    "receiptRef": { "type": "string", "minLength": 1 },
    "failureModeRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^https://socioprophet\\.github\\.io/ontogenesis/platform/reasoning-failure#"
      },
      "uniqueItems": true
    },
    "reasoningTask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskClass", "domain", "invariantRef"],
      "properties": {
        "taskClass": {
          "type": "string",
          "enum": ["exactness", "relation", "code", "causal", "temporal", "multimodal", "embodied", "social", "scientific", "multi-agent", "general"]
        },
        "domain": { "type": "string", "minLength": 1 },
        "invariantRef": { "type": "string", "minLength": 1 }
      }
    },
    "agentRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agentRef", "role", "capabilityEnvelopeRef", "governanceContextRef"],
      "properties": {
        "agentRef": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "capabilityEnvelopeRef": { "type": "string", "minLength": 1 },
        "governanceContextRef": { "type": "string", "minLength": 1 }
      }
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verifierRef", "verifierFamily", "required", "result"],
      "properties": {
        "verifierRef": { "type": "string", "minLength": 1 },
        "verifierFamily": {
          "type": "string",
          "enum": ["deterministic", "symbolic", "schema", "policy", "tool-backed", "human-review", "llm-judge-advisory"]
        },
        "required": { "type": "boolean" },
        "result": { "type": "string", "enum": ["passed", "failed", "requires-review", "blocked"] }
      }
    },
    "traceSteps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "description", "outcome"],
        "properties": {
          "step_id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "outcome": { "type": "string", "enum": ["ok", "failed", "inconclusive"] },
          "evidence_ref": { "type": "string", "minLength": 1 }
        }
      }
    },
    "inter_agent_alignment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agents": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "independent_evidence_required": { "type": "boolean" },
        "agreement_without_evidence": { "type": "boolean" }
      }
    },
    "recorded_at": { "type": "string", "format": "date-time" }
        "required": ["stepId", "actorRef", "action", "evidenceRefs"],
        "properties": {
          "stepId": { "type": "string", "minLength": 1 },
          "actorRef": { "type": "string", "minLength": 1 },
          "action": { "type": "string", "minLength": 1 },
          "evidenceRefs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
        }
      }
    },
    "invariantChecks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["invariantRef", "passed", "expected", "observed", "evidenceRef"],
        "properties": {
          "invariantRef": { "type": "string", "minLength": 1 },
          "passed": { "type": "boolean" },
          "expected": { "type": "string" },
          "observed": { "type": "string" },
          "evidenceRef": { "type": "string", "minLength": 1 }
        }
      }
    },
    "termination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terminationAuthorityRef", "candidateStatus", "finalStatus", "reason"],
      "properties": {
        "terminationAuthorityRef": { "type": "string", "minLength": 1 },
        "candidateStatus": { "type": "string", "enum": ["not-candidate", "candidate", "premature-candidate"] },
        "finalStatus": { "type": "string", "enum": ["open", "needs-review", "blocked", "closed"] },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "annotations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["annotationId", "cluster", "failureModeRef", "severity"],
        "properties": {
          "annotationId": { "type": "string", "minLength": 1 },
          "cluster": { "type": "string", "enum": ["specification-system-design", "inter-agent-misalignment", "task-verification-termination"] },
          "failureModeRef": {
            "type": "string",
            "pattern": "^https://socioprophet\\.github\\.io/ontogenesis/platform/reasoning-failure#"
          },
          "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] }
        }
      }
    },
    "evidenceRefs": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
    "riskAction": {
      "type": "string",
      "enum": ["record-only", "warn", "require-tool-verification", "require-independent-verifier", "require-human-review", "quarantine", "block", "rollback", "revoke-authority"]
    }
  }
}
